        "items_title": {
          "name": "items_title",
          "value": "btrim(\"items\".\"title\") <> '' and char_length(\"items\".\"title\") <= 80"
        },
        "items_price_xor_ask": {
          "name": "items_price_xor_ask",
          "value": "(\"items\".\"price_cents\" is not null) <> \"items\".\"ask_in_store\""
        },
        "items_price_range": {
          "name": "items_price_range",
          "value": "\"items\".\"price_cents\" is null or \"items\".\"price_cents\" between 0 and 100000000"
        },
        "items_category": {
          "name": "items_category",
          "value": "\"items\".\"category\" is null or \"items\".\"category\" in ('furniture', 'glass_china', 'pottery', 'jewelry', 'collectibles', 'art', 'lighting', 'textiles', 'books', 'home', 'other')"
        },
        "items_photo_size": {
          "name": "items_photo_size",
          "value": "\"items\".\"photo_w\" > 0 and \"items\".\"photo_h\" > 0"
        },
        "items_held_reason": {
          "name": "items_held_reason",
          "value": "\"items\".\"status\" <> 'held' or \"items\".\"hold_reason\" is not null"
        },
        "items_live_window": {
          "name": "items_live_window",
          "value": "\"items\".\"status\" in ('checking', 'held', 'removed') or (\"items\".\"live_at\" is not null and \"items\".\"expires_at\" is not null and \"items\".\"expires_at\" > \"items\".\"live_at\")"
        },
        "items_sold_pair": {
          "name": "items_sold_pair",
          "value": "(\"items\".\"sold_at\" is null) = (\"items\".\"sold_source\" is null)"
        },
        "items_sold_has_date": {
          "name": "items_sold_has_date",
          "value": "\"items\".\"status\" <> 'sold' or \"items\".\"sold_at\" is not null"
        },
        "items_sold_only_when_sold": {
          "name": "items_sold_only_when_sold",
          "value": "\"items\".\"sold_at\" is null or \"items\".\"status\" in ('sold', 'removed')"
        },
        "items_removed_has_date": {
          "name": "items_removed_has_date",
          "value": "(\"items\".\"status\" = 'removed') = (\"items\".\"removed_at\" is not null)"
        },
        "items_photo_deleted_only_off_page": {
          "name": "items_photo_deleted_only_off_page",
          "value": "\"items\".\"photo_deleted_at\" is null or \"items\".\"status\" in ('sold', 'expired', 'removed')"
        }
      },
